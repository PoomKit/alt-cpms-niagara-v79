    <Label layout="1500.0,368.0,60.0,20.0" text="▶ SA" font="bold 12.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Picture layout="250.0,210.0,32.0,114.0" image="module://kitPxGraphics/Sensors/sensor_duct_temphum_bottom.png"/>

    <Picture layout="1300.0,210.0,26.0,120.0" image="module://kitPxGraphics/Sensors/sensor_duct_avgtemp_bottom.png"/>

