    <Picture layout="1050.0,330.0,340.0,99.0" image="module://kitPxGraphics/Ductwork/Duct_Horz_Med.png"/>

    <Picture layout="1330.0,330.0,170.0,99.0" image="module://kitPxGraphics/Ductwork/Duct_Horz_Short.png"/>

    <Label layout="150.0,368.0,50.0,20.0" text="RA ▶" font="bold 12.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Picture layout="330.0,330.0,83.0,99.0" image="module://kitPxGraphics/Dampers/Damper_Horz_Parallel/Damper_Horz_Parallel_0.png">
      <ValueBinding ord="station:|slot:/AirSide/AHU01/Points/AHU01_OADamperCmd">
        <INumericToSimple name="image" map="gx:Image -inf:12.5=module://kitPxGraphics/Dampers/Damper_Horz_Parallel/Damper_Horz_Parallel_0.png;12.5:37.5=module://kitPxGraphics/Dampers/Damper_Horz_Parallel/Damper_Horz_Parallel_1.png;37.5:62.5=module://kitPxGraphics/Dampers/Damper_Horz_Parallel/Damper_Horz_Parallel_2.png;62.5:87.5=module://kitPxGraphics/Dampers/Damper_Horz_Parallel/Damper_Horz_Parallel_3.png;87.5:+inf=module://kitPxGraphics/Dampers/Damper_Horz_Parallel/Damper_Horz_Parallel_4.png;default=module://kitPxGraphics/Dampers/Damper_Horz_Parallel/Damper_Horz_Parallel_0.png;"/>
      </ValueBinding>
    </Picture>

    <Label layout="316.0,308.0,120.0,20.0" text="OA damper (CO2)" font="9.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Picture layout="520.0,330.0,99.0,99.0" image="module://kitPxGraphics/Filters/Filter_Single_Dp/Filter_Single_DP_0.png"/>

    <Picture layout="740.0,330.0,96.0,160.0" image="module://kitPxGraphics/Coils/Coils_Cooling_2Way_Bottom/Coils_Cooling_2Way_Bottom_0.png">
      <ValueBinding ord="station:|slot:/AirSide/AHU01/Points/AHU01_ValveFeedback">
        <INumericToSimple name="image" map="gx:Image -inf:12.5=module://kitPxGraphics/Coils/Coils_Cooling_2Way_Bottom/Coils_Cooling_2Way_Bottom_0.png;12.5:37.5=module://kitPxGraphics/Coils/Coils_Cooling_2Way_Bottom/Coils_Cooling_2Way_Bottom_1.png;37.5:62.5=module://kitPxGraphics/Coils/Coils_Cooling_2Way_Bottom/Coils_Cooling_2Way_Bottom_2.png;62.5:87.5=module://kitPxGraphics/Coils/Coils_Cooling_2Way_Bottom/Coils_Cooling_2Way_Bottom_3.png;87.5:+inf=module://kitPxGraphics/Coils/Coils_Cooling_2Way_Bottom/Coils_Cooling_2Way_Bottom_4.png;default=module://kitPxGraphics/Coils/Coils_Cooling_2Way_Bottom/Coils_Cooling_2Way_Bottom_0.png;"/>
      </ValueBinding>
