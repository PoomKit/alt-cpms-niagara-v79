    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="180.0,110.0,230.0,110.0"/>

    <Label layout="180.0,110.0,230.0,20.0" text="  RETURN AIR" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

    <Label layout="184.0,132.0,106.0,20.0" text="RAT" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="290.0,133.0,116.0,18.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/AirSide/AHU01/Points/AHU01_RAT" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
