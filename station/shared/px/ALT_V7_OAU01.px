    <Label layout="180.0,720.0,1300.0,15.3" text="Sequence (SOO OAU): schedule → fire/HOA/overload → fan at minimum → VSD holds design airflow → CHW valve holds leaving air 16.5 °C (10.5 °C office dehumidification) after fan proof. LAT invalid → valve 70 %; airflow invalid → fan 80" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <Label layout="180.0,735.3,1300.0,15.3" text="%." font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

