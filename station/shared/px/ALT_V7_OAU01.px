      </BoundLabelBinding>
    </BoundLabel>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="700.0,470.0,240.0,140.0"/>

    <Label layout="700.0,470.0,240.0,20.0" text="  CHW VALVE (PID on LAT)" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

    <Label layout="704.0,492.0,116.0,20.0" text="Command %" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="820.0,493.0,116.0,18.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/AirSide/OAU01/Points/OAU01_ValveCmd" popupEnabled="true" statusEffect="none">
