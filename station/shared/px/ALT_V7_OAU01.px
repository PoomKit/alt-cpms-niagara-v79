    <Picture layout="200.0,330.0,850.0,99.0" image="module://kitPxGraphics/Ductwork/Duct_Horz_XLong.png"/>

    <Picture layout="1050.0,330.0,340.0,99.0" image="module://kitPxGraphics/Ductwork/Duct_Horz_Med.png"/>

    <Picture layout="1330.0,330.0,170.0,99.0" image="module://kitPxGraphics/Ductwork/Duct_Horz_Short.png"/>

    <Label layout="150.0,368.0,50.0,20.0" text="OA ▶" font="bold 12.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Picture layout="330.0,330.0,83.0,99.0" image="module://kitPxGraphics/Dampers/Damper_Horz_Parallel/Damper_Horz_Parallel_4.png"/>

    <Picture layout="520.0,330.0,99.0,99.0" image="module://kitPxGraphics/Filters/Filter_Single_Dp/Filter_Single_DP_0.png"/>

    <Picture layout="740.0,330.0,96.0,160.0" image="module://kitPxGraphics/Coils/Coils_Cooling_2Way_Bottom/Coils_Cooling_2Way_Bottom_0.png">
      <ValueBinding ord="station:|slot:/AirSide/OAU01/Points/OAU01_ValveFeedback">
        <INumericToSimple name="image" map="gx:Image -inf:12.5=module://kitPxGraphics/Coils/Coils_Cooling_2Way_Bottom/Coils_Cooling_2Way_Bottom_0.png;12.5:37.5=module://kitPxGraphics/Coils/Coils_Cooling_2Way_Bottom/Coils_Cooling_2Way_Bottom_1.png;37.5:62.5=module://kitPxGraphics/Coils/Coils_Cooling_2Way_Bottom/Coils_Cooling_2Way_Bottom_2.png;62.5:87.5=module://kitPxGraphics/Coils/Coils_Cooling_2Way_Bottom/Coils_Cooling_2Way_Bottom_3.png;87.5:+inf=module://kitPxGraphics/Coils/Coils_Cooling_2Way_Bottom/Coils_Cooling_2Way_Bottom_4.png;default=module://kitPxGraphics/Coils/Coils_Cooling_2Way_Bottom/Coils_Cooling_2Way_Bottom_0.png;"/>
      </ValueBinding>
    </Picture>

    <Picture layout="1000.0,330.0,134.0,99.0" image="module://kitPxGraphics/Fans/Fans_Horz/Fans_Horz_Right/Fans_Horz_Right_Off.png">
      <ValueBinding ord="station:|slot:/AirSide/OAU01/Points/OAU01_Status">
        <IBooleanToSimple name="image">
          <Image name="trueValue" value="module://kitPxGraphics/Fans/Fans_Horz/Fans_Horz_Right/Fans_Horz_Right_On.gif"/>
          <Image name="falseValue" value="module://kitPxGraphics/Fans/Fans_Horz/Fans_Horz_Right/Fans_Horz_Right_Off.png"/>
        </IBooleanToSimple>
      </ValueBinding>
    </Picture>

    <Label layout="1500.0,368.0,60.0,20.0" text="▶ SA" font="bold 12.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Picture layout="1300.0,210.0,32.0,114.0" image="module://kitPxGraphics/Sensors/sensor_duct_temphum_bottom.png"/>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="180.0,110.0,260.0,110.0"/>

    <Label layout="180.0,110.0,260.0,20.0" text="  OUTDOOR AIR" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

    <Label layout="184.0,132.0,126.0,20.0" text="OA dry bulb" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="310.0,133.0,126.0,18.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/OutdoorAir/OA_Temperature" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="184.0,153.0,126.0,20.0" text="OA RH" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="310.0,154.0,126.0,18.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/OutdoorAir/OA_Humidity" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="184.0,174.0,126.0,20.0" text="OA wet bulb" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="310.0,175.0,126.0,18.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
