    <Label layout="704.0,555.0,116.0,20.0" text="CHW request" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="820.0,556.0,116.0,18.0" font="bold 10.0pt sans-serif" foreground="white" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/AirSide/OAU01/Monitor/OAU01_ChwRequest" popupEnabled="true" statusEffect="none">
