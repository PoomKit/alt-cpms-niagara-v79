    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="1240.0,110.0,320.0,130.0"/>

    <Label layout="1240.0,110.0,320.0,20.0" text="  LEAVING AIR (dehumidified)" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

    <Label layout="1244.0,132.0,166.0,20.0" text="LAT" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="1410.0,133.0,146.0,18.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/AirSide/OAU01/Points/OAU01_LAT" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="1244.0,153.0,166.0,20.0" text="LAT setpoint" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="1410.0,154.0,146.0,18.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652" mouseOver="outline">
      <ActionBinding ord="station:|slot:/AirSide/OAU01/Points/OAU01_LAT_SP/set" widgetEvent="actionPerformed"/>
      <BoundLabelBinding ord="station:|slot:/AirSide/OAU01/Points/OAU01_LAT_SP" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
