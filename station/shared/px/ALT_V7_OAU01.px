    </BoundLabel>

    <Label layout="704.0,576.0,116.0,20.0" text="Cooling call" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="820.0,577.0,116.0,18.0" font="bold 10.0pt sans-serif" foreground="white" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/AirSide/OAU01/Monitor/OAU01_CoolingCall" popupEnabled="true" statusEffect="none">
