    <Label layout="704.0,534.0,116.0,20.0" text="Mismatch" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="820.0,535.0,116.0,18.0" font="bold 10.0pt sans-serif" foreground="white" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/AirSide/OAU01/Monitor/OAU01_ValveMismatchAlarm" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#f39c12"/>
          <Brush name="falseValue" value="#1f6f43"/>
        </IBooleanToSimple>
