      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="704.0,513.0,116.0,20.0" text="Feedback %" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="820.0,514.0,116.0,18.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/AirSide/OAU01/Points/OAU01_ValveFeedback" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
