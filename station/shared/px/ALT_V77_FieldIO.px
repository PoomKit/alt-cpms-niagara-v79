    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="10.0,80.0,1900.0,120.0"/>

    <Label layout="10.0,80.0,1900.0,20.0" text="  FIELD INTERFACE  (FIELD takes effect only when Drivers installed = true; otherwise the group stays in SIMULATION)" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

    <Label layout="14.0,104.0,296.0,20.0" text="All groups use field points" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="310.0,105.0,296.0,23.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652" mouseOver="outline">
      <ActionBinding ord="station:|slot:/ChillerPlant/FieldIO/Common/IO_AllField/set" widgetEvent="actionPerformed"/>
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/FieldIO/Common/IO_AllField" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="14.0,130.0,296.0,20.0" text="Drivers installed (enables FIELD)" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="310.0,131.0,296.0,23.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652" mouseOver="outline">
      <ActionBinding ord="station:|slot:/ChillerPlant/FieldIO/Common/IO_DriversInstalled/set" widgetEvent="actionPerformed"/>
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/FieldIO/Common/IO_DriversInstalled" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="14.0,156.0,296.0,20.0" text="Source now" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="310.0,157.0,296.0,23.0" font="bold 10.0pt sans-serif" foreground="white" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/FieldIO/Common/IO_AnyFieldSts" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#e74c3c"/>
          <Brush name="falseValue" value="#2ecc71"/>
        </IBooleanToSimple>
      </BoundLabelBinding>
    </BoundLabel>

    <BoundLabel layout="640.0,170.0,1260.0,24.0" font="bold 10.0pt sans-serif" foreground="white" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/FieldIO/Common/IO_FieldBlockedSts" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#f39c12"/>
          <Brush name="falseValue" value="#1b2631"/>
        </IBooleanToSimple>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="640.0,100.0,1260.0,20.0" text="Each field point P has a landing point IO_P in FieldIO/&lt;group&gt;: inputs  P.in10 &lt;- IO_P (FIELD) or the emulation (SIMULATION);" font="9.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="640.0,122.0,1260.0,20.0" text="outputs  IO_P.in10 &lt;- P (FIELD) or {null} (SIMULATION / isolated). Link the driver proxy point (BACnet / Modbus / I/O) to IO_P." font="9.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="640.0,144.0,1260.0,20.0" text="Protocol: 1 BACnet/IP · 2 BACnet MS/TP · 3 Modbus TCP · 4 Modbus RTU · 5 hard-wired I/O  (addresses: V7_7_FIELD_IO_REGISTER.csv)" font="9.0pt sans-serif" foreground="#e8edf2" halign="left"/>

