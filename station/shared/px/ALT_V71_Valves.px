    <Label layout="1380.0,80.0,530.0,20.0" text="  SYMBOLS (V7.4 butterfly valves)" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

    <Picture layout="1420.0,105.7,40.0,56.0" image="file:^px/img/v74_bfv_onoff_h_8.png"/>

    <Label layout="1500.0,136.0,400.0,20.0" text="Butterfly + on/off actuator (red)" font="9.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Picture layout="1420.0,157.7,40.0,56.0" image="file:^px/img/v74_bfv_mod_h_4.png"/>

    <Label layout="1500.0,188.0,400.0,20.0" text="Butterfly + modulating actuator (green)" font="9.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Picture layout="1420.0,216.6,40.0,48.0" image="file:^px/img/v74_bfv_man_h.png"/>

    <Label layout="1500.0,240.0,400.0,20.0" text="Butterfly, manual gear + handwheel" font="9.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Picture layout="1425.0,274.1,30.0,42.0" image="file:^px/img/v73_gate_h.png"/>

    <Label layout="1500.0,292.0,400.0,20.0" text="Gate valve (manual bypass loop)" font="9.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Picture layout="1426.0,328.7,28.0,40.0" image="file:^px/img/v73_sol_h.png"/>

    <Label layout="1500.0,344.0,400.0,20.0" text="Solenoid valve (make-up / fill / bleed)" font="9.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Picture layout="1392.0,378.1,96.0,56.0" image="file:^px/img/v73_rpz.png"/>

    <Label layout="1500.0,396.0,400.0,20.0" text="RPZ backflow preventer (CHW fill)" font="9.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="1392.0,430.0,510.0,20.0" text="Actuator picture follows the valve position (9 steps) + yellow/green bar = % open." font="8.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <Label layout="1392.0,450.0,510.0,20.0" text="Amber rotating lamp on the actuator = motor running (command and position differ)." font="8.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <Label layout="1392.0,470.0,510.0,20.0" text="On/off valves without a % feedback: position estimated from the stroke time." font="8.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="20.0,818.0,1890.0,254.0"/>

    <Label layout="20.0,818.0,1890.0,20.0" text="  SELECTION RULE" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

    <Label layout="34.0,844.0,1860.0,20.0" text="On/off (2-position) = isolation / sequencing: chiller inlets, pump suction + discharge (with the pump), tower inlets / outlets (latched on failure)." font="9.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="34.0,866.0,1860.0,20.0" text="Modulating 0-100 % = controls a process variable: evaporator flow limit (FCV), condenser head pressure (HPV), CHW min-flow bypass (on the sum of evaporator flows)." font="9.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="34.0,888.0,1860.0,20.0" text="Bypass: isolation butterflies (manual) both sides of the MOD valve + normally-closed manual bypass loop for maintenance (position switch alarm). No bypass flow meter." font="9.0pt sans-serif" foreground="#e8edf2" halign="left"/>

