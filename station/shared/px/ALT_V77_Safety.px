    <Label layout="646.0,948.0,1250.0,18.0" text="Night high-limit: outside Sch_AHU, RAT &gt; 29 °C → AHU runs until &lt; 27 °C. OAU: dew point &gt; 16 °C → LAT SP − 1.5 K; smoke → stop (latched)." font="8.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="646.0,966.0,1250.0,18.0" text="Fire alarm stops AHU / OAU / FCU, starts stair pressurisation + smoke exhaust (V7). CO2 DCV: OA damper reset 800 → 1,100 ppm (V7)." font="8.0pt sans-serif" foreground="#e8edf2" halign="left"/>

