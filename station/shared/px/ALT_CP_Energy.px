    <Rect fill="#1f252c" stroke="#3b4652" pen="2.0" geom="10.0,80.0,520.0,380.0"/>

    <Label layout="10.0,80.0,520.0,24.0" text="  PLANT EFFICIENCY" font="bold 12.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

    <Label layout="30.0,116.0,200.0,26.0" text="Plant kW/RT" font="bold 14.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <BoundLabel background="#0b0e11" layout="230.0,110.0,280.0,60.0" font="bold 30.0pt sans-serif" foreground="#ffe066" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Energy/Plant_kW_per_RT" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
        <INumericToSimple name="background" map="gx:Brush 0.0:0.01=#2c3440;0.01:0.75=#1e8449;0.75:0.9=#7dcea0;0.9:1.0=#f4d03f;1.0:99.0=#e74c3c;default=#2c3440;"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="30.0,190.0,200.0,22.0" text="Plant COP" font="11.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <BoundLabel background="#0b0e11" layout="230.0,190.0,160.0,22.0" font="12.0pt sans-serif" foreground="#ffe066" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Energy/Plant_COP" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="30.0,218.0,200.0,22.0" text="Cooling load kW" font="11.0pt sans-serif" foreground="#e8edf2" halign="left"/>

