    <Label layout="30.0,694.0,740.0,17.0" text="kWh points are NumericTotalizerExt (hourly) on the kW points; runtime is DiscreteTotalizerExt on proven-run points. All" font="10.0pt sans-serif" foreground="#9aa5b1" halign="left"/>

    <Label layout="30.0,711.0,740.0,17.0" text="are trended (interval 1 min) for daily/monthly reports in the History / Report services." font="10.0pt sans-serif" foreground="#9aa5b1" halign="left"/>

    <Rect fill="#1f252c" stroke="#3b4652" pen="2.0" geom="800.0,470.0,790.0,420.0"/>

    <Label layout="800.0,470.0,790.0,24.0" text="  ENERGY PARAMETERS (simulation / project values)" font="bold 12.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

