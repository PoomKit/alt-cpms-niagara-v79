    <Label layout="1320.0,116.0,110.0,20.0" text="CT01" font="bold 11.0pt sans-serif" foreground="#e8edf2" halign="center"/>

    <Bargraph background="#0b0e11" foreground="#e8edf2" layout="1340.0,140.0,70.0,250.0" max="12.0" valueFont="11.0pt SansSerif" scaleFont="10.0pt SansSerif" scaleVisible="false">
      <ValueBinding ord="station:|slot:/ChillerPlant/CT01/Points/CT01_kW">
        <INumericToNumber name="value"/>
        <ObjectToString name="text" format="%out.value%"/>
        <INumericToSimple name="fill" map="gx:Brush 0.0:120.0=#43a047;default=#2c3440;"/>
      </ValueBinding>
    </Bargraph>

    <BoundLabel background="#0b0e11" layout="1320.0,400.0,110.0,22.0" font="12.0pt sans-serif" foreground="#ffe066" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/CT01/Points/CT01_kW" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="1445.0,116.0,110.0,20.0" text="CT02" font="bold 11.0pt sans-serif" foreground="#e8edf2" halign="center"/>

    <Bargraph background="#0b0e11" foreground="#e8edf2" layout="1465.0,140.0,70.0,250.0" max="12.0" valueFont="11.0pt SansSerif" scaleFont="10.0pt SansSerif" scaleVisible="false">
      <ValueBinding ord="station:|slot:/ChillerPlant/CT02/Points/CT02_kW">
