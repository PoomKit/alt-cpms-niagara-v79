    <Label layout="1711.1,44.0,65.3,26.0" text="OAU-01" font="bold 8.5pt sans-serif" foreground="#cfd8dc" background="#233a33" halign="center">
      <ValueBinding ord="station:|slot:/" hyperlink="file:^px/ALT_V7_OAU01.px" popupEnabled="false"/>
    </Label>

    <Label layout="1779.4,44.0,65.3,26.0" text="FCU" font="bold 8.5pt sans-serif" foreground="#cfd8dc" background="#233a33" halign="center">
      <ValueBinding ord="station:|slot:/" hyperlink="file:^px/ALT_V7_FCU.px" popupEnabled="false"/>
    </Label>

    <Label layout="1847.7,44.0,65.3,26.0" text="Ventilation" font="bold 8.5pt sans-serif" foreground="#cfd8dc" background="#233a33" halign="center">
      <ValueBinding ord="station:|slot:/" hyperlink="file:^px/ALT_V7_Ventilation.px" popupEnabled="false"/>
    </Label>

    <Rect fill="#1f252c" stroke="#3b4652" pen="2.0" geom="10.0,80.0,256.0,118.0"/>

    <Label layout="16.0,86.0,244.0,22.0" text="Plant COP" font="bold 11.0pt sans-serif" foreground="#9aa5b1" halign="left"/>

    <BoundLabel background="#0b0e11" layout="18.0,116.0,240.0,64.0" font="bold 24.0pt sans-serif" foreground="#ffe066" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Energy/Plant_COP" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Rect fill="#1f252c" stroke="#3b4652" pen="2.0" geom="272.0,80.0,256.0,118.0"/>

    <Label layout="278.0,86.0,244.0,22.0" text="Plant power" font="bold 11.0pt sans-serif" foreground="#9aa5b1" halign="left"/>

    <BoundLabel background="#0b0e11" layout="280.0,116.0,240.0,64.0" font="bold 22.0pt sans-serif" foreground="#ffe066" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Energy/Plant_kW" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
