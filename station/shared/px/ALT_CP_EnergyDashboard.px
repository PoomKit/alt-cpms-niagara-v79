    <Label layout="24.0,382.0,220.0,30.0" text="Plant kW/RT" font="bold 12.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <BoundLabel background="#0b0e11" layout="250.0,382.0,164.0,30.0" font="bold 13.0pt sans-serif" foreground="#ffe066" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Energy/Plant_kW_per_RT_Today" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
        <INumericToSimple name="background" map="gx:Brush 0.0:0.01=#2c3440;0.01:0.75=#1e8449;0.75:0.9=#7dcea0;0.9:1.0=#f4d03f;1.0:99.0=#e74c3c;default=#2c3440;"/>
