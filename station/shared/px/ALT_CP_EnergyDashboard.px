    <Label layout="760.0,242.0,164.0,26.0" text="Last month" font="bold 11.0pt sans-serif" foreground="white" background="#2c3e50" halign="center"/>

    <Label layout="24.0,274.0,220.0,30.0" text="Plant energy" font="bold 12.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <BoundLabel background="#0b0e11" layout="250.0,274.0,164.0,30.0" font="13.0pt sans-serif" foreground="#ffe066" halign="center" border="1.0 solid #3b4652">
