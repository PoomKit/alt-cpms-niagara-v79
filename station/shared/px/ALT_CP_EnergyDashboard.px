    <Label layout="10.0,210.0,930.0,24.0" text="  ENERGY BY PERIOD (resets: day 00:00, month day-1 00:02)" font="bold 12.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

    <Label layout="250.0,242.0,164.0,26.0" text="Today" font="bold 11.0pt sans-serif" foreground="white" background="#2c3e50" halign="center"/>

    <Label layout="420.0,242.0,164.0,26.0" text="Yesterday" font="bold 11.0pt sans-serif" foreground="white" background="#2c3e50" halign="center"/>

