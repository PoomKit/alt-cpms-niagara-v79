    <Label layout="1064.0,86.0,244.0,22.0" text="Auxiliary power" font="bold 11.0pt sans-serif" foreground="#9aa5b1" halign="left"/>

    <BoundLabel background="#0b0e11" layout="1066.0,116.0,240.0,64.0" font="bold 22.0pt sans-serif" foreground="#ffe066" halign="center" border="1.0 solid #3b4652">
