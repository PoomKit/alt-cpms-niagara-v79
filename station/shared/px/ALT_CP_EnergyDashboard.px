    <Rect fill="#1f252c" stroke="#3b4652" pen="2.0" geom="796.0,80.0,256.0,118.0"/>

    <Label layout="802.0,86.0,244.0,22.0" text="Chiller power" font="bold 11.0pt sans-serif" foreground="#9aa5b1" halign="left"/>

    <Label layout="804.0,116.0,44.0,26.0" text="CH01" font="10.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <BoundLabel background="#0b0e11" layout="848.0,114.0,192.0,30.0" font="bold 16.0pt sans-serif" foreground="#ffe066" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Chiller01/Points/CH01_kW" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="804.0,152.0,44.0,26.0" text="CH02" font="10.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <BoundLabel background="#0b0e11" layout="848.0,150.0,192.0,30.0" font="bold 16.0pt sans-serif" foreground="#ffe066" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Chiller02/Points/CH02_kW" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
