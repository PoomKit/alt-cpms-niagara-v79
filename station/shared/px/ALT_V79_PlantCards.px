<?xml version="1.0" encoding="UTF-8"?>
<!-- Niagara Presentation XML -->
<px version="1.0" media="uxBuilder:UxMedia">
<import>
  <module name="baja"/>
  <module name="bajaui"/>
  <module name="converters"/>
  <module name="gx"/>
  <module name="kitPx"/>
</import>
<content>
<ScrollPane>

  <CanvasPane name="content" viewSize="1920.0,1080.0" scale="fitRatio" minScaleFactor="0.5" maxScaleFactor="1.0">

    <Rect fill="#12161b" stroke="#12161b" pen="1.0" geom="0.0,0.0,1920.0,1080.0"/>

    <Label layout="0.0,0.0,1920.0,40.0" text="  ALT Reference V7.9 — Chiller plant · 6 slots per type (cards)" font="bold 18.0pt sans-serif" foreground="white" background="#0b0e11" halign="left"/>

    <Label layout="1450.0,8.0,460.0,24.0" text="SAME DATA AS 3D DIGITAL TWIN · REFERENCE SIMULATION" font="bold 10.0pt sans-serif" foreground="#263238" background="#ffca28" halign="center"/>

    <Label layout="8.0,44.0,150.0,26.0" text="Plant schematic" font="bold 9.0pt sans-serif" foreground="#cfd8dc" background="#2c3440" halign="center">
      <PopupBinding ord="file:^px/ALT_V79_Plant_Details.px" title="Plant schematic"/>
    </Label>

    <Label layout="162.0,44.0,150.0,26.0" text="Plant cards" font="bold 9.0pt sans-serif" foreground="white" background="#1e88e5" halign="center"/>

    <Label layout="316.0,44.0,150.0,26.0" text="Building / Zones" font="bold 9.0pt sans-serif" foreground="#cfd8dc" background="#2c3440" halign="center">
      <PopupBinding ord="file:^px/ALT_V79_Building.px" title="Building / Zones"/>
    </Label>

    <Label layout="470.0,44.0,150.0,26.0" text="3D Live" font="bold 9.0pt sans-serif" foreground="#cfd8dc" background="#2c3440" halign="center">
      <PopupBinding ord="file:^px/ALT_V79_Building3D.px" title="3D building"/>
    </Label>

    <Label layout="624.0,44.0,150.0,26.0" text="Field IO" font="bold 9.0pt sans-serif" foreground="#cfd8dc" background="#2c3440" halign="center">
      <PopupBinding ord="file:^px/ALT_V77_FieldIO.px" title="Field IO"/>
    </Label>

    <Label layout="778.0,44.0,150.0,26.0" text="Alarms" font="bold 9.0pt sans-serif" foreground="#cfd8dc" background="#2c3440" halign="center">
      <PopupBinding ord="file:^px/ALT_CP_AlarmsHistory.px" title="Alarms"/>
    </Label>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="8.0,80.0,112.0,48.0"/>

    <Label layout="8.0,82.0,112.0,16.0" text="Plant" font="9.0pt sans-serif" foreground="#9aa5b1" halign="center"/>

    <BoundLabel layout="14.0,100.0,100.0,24.0" font="bold 12.0pt sans-serif" foreground="white" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/PlantControl/Points/PlantRunRequest" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#2ecc71"/>
          <Brush name="falseValue" value="#5d6d7e"/>
        </IBooleanToSimple>
      </BoundLabelBinding>
    </BoundLabel>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="124.0,80.0,112.0,48.0"/>

    <Label layout="124.0,82.0,112.0,16.0" text="Stage" font="9.0pt sans-serif" foreground="#9aa5b1" halign="center"/>

    <BoundLabel layout="130.0,100.0,100.0,24.0" font="bold 12.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/PlantControl/Points/PlantStage" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="240.0,80.0,112.0,48.0"/>

    <Label layout="240.0,82.0,112.0,16.0" text="Mode" font="9.0pt sans-serif" foreground="#9aa5b1" halign="center"/>

    <BoundLabel layout="246.0,100.0,100.0,24.0" font="bold 12.0pt sans-serif" foreground="white" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/ModeControl/OperationMode" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#8e44ad"/>
          <Brush name="falseValue" value="#34495e"/>
        </IBooleanToSimple>
      </BoundLabelBinding>
    </BoundLabel>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="356.0,80.0,112.0,48.0"/>

    <Label layout="356.0,82.0,112.0,16.0" text="CHWS SP" font="9.0pt sans-serif" foreground="#9aa5b1" halign="center"/>

    <BoundLabel layout="362.0,100.0,100.0,24.0" font="bold 12.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/ModeControl/CHW_LeavingTemperatureSetpoint_ACTIVE" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="472.0,80.0,112.0,48.0"/>

    <Label layout="472.0,82.0,112.0,16.0" text="CHWS" font="9.0pt sans-serif" foreground="#9aa5b1" halign="center"/>

    <BoundLabel layout="478.0,100.0,100.0,24.0" font="bold 12.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/ChwLoop/Points/CHWS" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="588.0,80.0,112.0,48.0"/>

    <Label layout="588.0,82.0,112.0,16.0" text="CHWR" font="9.0pt sans-serif" foreground="#9aa5b1" halign="center"/>

    <BoundLabel layout="594.0,100.0,100.0,24.0" font="bold 12.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/ChwLoop/Points/CHWR" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="704.0,80.0,112.0,48.0"/>

    <Label layout="704.0,82.0,112.0,16.0" text="Load" font="9.0pt sans-serif" foreground="#9aa5b1" halign="center"/>

    <BoundLabel layout="710.0,100.0,100.0,24.0" font="bold 12.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Energy/CoolingLoad_RT" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="820.0,80.0,112.0,48.0"/>

    <Label layout="820.0,82.0,112.0,16.0" text="Plant kW" font="9.0pt sans-serif" foreground="#9aa5b1" halign="center"/>

    <BoundLabel layout="826.0,100.0,100.0,24.0" font="bold 12.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Energy/Plant_kW" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="936.0,80.0,112.0,48.0"/>

    <Label layout="936.0,82.0,112.0,16.0" text="kW/RT" font="9.0pt sans-serif" foreground="#9aa5b1" halign="center"/>

    <BoundLabel layout="942.0,100.0,100.0,24.0" font="bold 12.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Energy/Plant_kW_per_RT" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="1052.0,80.0,112.0,48.0"/>

    <Label layout="1052.0,82.0,112.0,16.0" text="COP" font="9.0pt sans-serif" foreground="#9aa5b1" halign="center"/>

    <BoundLabel layout="1058.0,100.0,100.0,24.0" font="bold 12.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Energy/Plant_COP" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="1168.0,80.0,112.0,48.0"/>

    <Label layout="1168.0,82.0,112.0,16.0" text="OA DB" font="9.0pt sans-serif" foreground="#9aa5b1" halign="center"/>

    <BoundLabel layout="1174.0,100.0,100.0,24.0" font="bold 12.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/OutdoorAir/OA_Temperature" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="1284.0,80.0,112.0,48.0"/>

    <Label layout="1284.0,82.0,112.0,16.0" text="OA WB" font="9.0pt sans-serif" foreground="#9aa5b1" halign="center"/>

    <BoundLabel layout="1290.0,100.0,100.0,24.0" font="bold 12.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/OutdoorAir/OA_WetBulb" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Button layout="1406.0,82.0,150.0,22.0" text="RESET ALL" font="bold 10.0pt sans-serif" foreground="white" background="#c62828">
      <ActionBinding ord="station:|slot:/ChillerPlant/Alarms/Plant/PlantAlarmResetFire/fire" widgetEvent="actionPerformed"/>
    </Button>

    <Button layout="1406.0,106.0,72.0,22.0" text="PLANT ON" font="bold 11.0pt sans-serif">
      <ActionBinding ord="station:|slot:/ChillerPlant/PlantControl/Points/PlantEnable/set" widgetEvent="actionPerformed">
        <Boolean name="actionArg" value="true"/>
      </ActionBinding>
      <ValueBinding ord="station:|slot:/ChillerPlant/PlantControl/Points/PlantEnable" popupEnabled="false">
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#00a000"/>
          <Brush name="falseValue" value="white"/>
        </IBooleanToSimple>
      </ValueBinding>
    </Button>

    <Button layout="1484.0,106.0,72.0,22.0" text="OFF" font="bold 11.0pt sans-serif">
      <ActionBinding ord="station:|slot:/ChillerPlant/PlantControl/Points/PlantEnable/set" widgetEvent="actionPerformed">
        <Boolean name="actionArg" value="false"/>
      </ActionBinding>
      <ValueBinding ord="station:|slot:/ChillerPlant/PlantControl/Points/PlantEnable" popupEnabled="false">
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="white"/>
          <Brush name="falseValue" value="#546e7a"/>
        </IBooleanToSimple>
      </ValueBinding>
    </Button>

    <Button layout="1564.0,82.0,90.0,22.0" text="QUALIFY" font="bold 11.0pt sans-serif">
      <ActionBinding ord="station:|slot:/ChillerPlant/PlantControl/Points/BootQualified/set" widgetEvent="actionPerformed">
        <Boolean name="actionArg" value="true"/>
      </ActionBinding>
      <ValueBinding ord="station:|slot:/ChillerPlant/PlantControl/Points/BootQualified" popupEnabled="false">
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#00a000"/>
          <Brush name="falseValue" value="white"/>
        </IBooleanToSimple>
      </ValueBinding>
    </Button>

    <Button layout="1564.0,106.0,90.0,22.0" text="AI / LOCAL" font="bold 11.0pt sans-serif">
      <ActionBinding ord="station:|slot:/ChillerPlant/ModeControl/ModeCmd_UI/set" widgetEvent="actionPerformed">
        <Boolean name="actionArg" value="true"/>
      </ActionBinding>
      <ValueBinding ord="station:|slot:/ChillerPlant/ModeControl/ModeCmd_UI" popupEnabled="false">
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#00a000"/>
          <Brush name="falseValue" value="white"/>
        </IBooleanToSimple>
      </ValueBinding>
    </Button>

    <Label layout="8.0,136.0,300.0,20.0" text="CHILLERS  (slot 01-02 = V7.8 base · 03-06 = expansion)" font="bold 10.0pt sans-serif" foreground="white" halign="left"/>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="8.0,156.0,228.0,238.0"/>

    <Label layout="8.0,156.0,228.0,20.0" text="  CH-01" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

    <BoundLabel layout="144.0,158.0,88.0,16.0" font="bold 8.0pt sans-serif" foreground="white" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Chiller01/Permissive/CH01_Installed" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#1f6f43"/>
          <Brush name="falseValue" value="#5d6d7e"/>
        </IBooleanToSimple>
      </BoundLabelBinding>
    </BoundLabel>

    <Picture layout="53.0,180.0,138.0,92.0" image="module://kitPxGraphics/Chillers/Turbo/Chiller_Turbo_Left/Chiller_Turbo_Left_Off.png" scaleFactor="1.0">
      <ValueBinding ord="station:|slot:/ChillerPlant/Chiller01/Points/CH01RunProof">
        <IBooleanToSimple name="image">
          <Image name="trueValue" value="module://kitPxGraphics/Chillers/Turbo/Chiller_Turbo_Left/Chiller_Turbo_Left_On.gif"/>
          <Image name="falseValue" value="module://kitPxGraphics/Chillers/Turbo/Chiller_Turbo_Left/Chiller_Turbo_Left_Off.png"/>
        </IBooleanToSimple>
      </ValueBinding>
    </Picture>

    <Label layout="14.0,276.0,112.0,20.0" text="Load %" font="9.0pt sans-serif" foreground="#9aa5b1" halign="left"/>

    <BoundLabel layout="126.0,277.0,104.0,17.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
