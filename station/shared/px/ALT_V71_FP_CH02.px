<?xml version="1.0" encoding="UTF-8"?>
<!-- Niagara Presentation XML -->
<px version="1.0" media="uxBuilder:UxMedia">
<import>
  <module name="baja"/>
  <module name="bajaui"/>
  <module name="converters"/>
  <module name="gx"/>
  <module name="kitPx"/>
</import>
<content>
<ScrollPane>

  <CanvasPane name="content" viewSize="620.0,900.0" scale="fitRatio" minScaleFactor="0.5" maxScaleFactor="1.0">

    <Rect fill="#12161b" stroke="#12161b" pen="1.0" geom="0.0,0.0,620.0,900.0"/>

    <Label layout="0.0,0.0,620.0,34.0" text="  Chiller 02 — TT / FT / DPT / power meter / valves" font="bold 14.0pt sans-serif" foreground="white" background="#0b0e11" halign="left"/>

    <Picture layout="20.0,44.0,220.0,100.0" image="module://kitPxGraphics/Chillers/Generic/Chiller_Generic_Off.png">
      <ValueBinding ord="station:|slot:/ChillerPlant/Chiller02/Proof/CH02RunProofSelected">
        <IBooleanToSimple name="image">
          <Image name="trueValue" value="module://kitPxGraphics/Chillers/Generic/Chiller_Generic_On.gif"/>
          <Image name="falseValue" value="module://kitPxGraphics/Chillers/Generic/Chiller_Generic_Off.png"/>
        </IBooleanToSimple>
      </ValueBinding>
    </Picture>

    <Label layout="264.0,44.0,176.0,20.0" text="Start command" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="440.0,45.0,166.0,19.0" font="bold 10.0pt sans-serif" foreground="white" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Chiller02/Points/CH02StartCmd" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#2ecc71"/>
          <Brush name="falseValue" value="#5d6d7e"/>
        </IBooleanToSimple>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="264.0,66.0,176.0,20.0" text="CHW valve proof" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="440.0,67.0,166.0,19.0" font="bold 10.0pt sans-serif" foreground="white" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Chiller02/Points/CH02ValveOpenProof" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#2ecc71"/>
          <Brush name="falseValue" value="#5d6d7e"/>
        </IBooleanToSimple>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="264.0,88.0,176.0,20.0" text="CDW valve proof" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="440.0,89.0,166.0,19.0" font="bold 10.0pt sans-serif" foreground="white" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Chiller02/Points/CH02CdwValveOpenProof" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#2ecc71"/>
          <Brush name="falseValue" value="#5d6d7e"/>
        </IBooleanToSimple>
