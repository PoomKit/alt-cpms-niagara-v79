      <ActionBinding ord="station:|slot:/ChillerPlant/Parameters/Pumps/CDP_DesignFlow/set" widgetEvent="actionPerformed"/>
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Parameters/Pumps/CDP_DesignFlow" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="14.0,788.0,516.0,20.0" text="CDP design head" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="530.0,789.0,416.0,35.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652" mouseOver="outline">
      <ActionBinding ord="station:|slot:/ChillerPlant/Parameters/Pumps/CDP_DesignHead/set" widgetEvent="actionPerformed"/>
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Parameters/Pumps/CDP_DesignHead" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="14.0,826.0,516.0,20.0" text="CDP motor kW" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="530.0,827.0,416.0,35.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652" mouseOver="outline">
      <ActionBinding ord="station:|slot:/ChillerPlant/Parameters/Pumps/CDP_RatedKW/set" widgetEvent="actionPerformed"/>
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Parameters/Pumps/CDP_RatedKW" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="14.0,864.0,516.0,20.0" text="Tower cell fan kW" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="530.0,865.0,416.0,35.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652" mouseOver="outline">
      <ActionBinding ord="station:|slot:/ChillerPlant/Parameters/CoolingTowers/CT_CellRatedKW/set" widgetEvent="actionPerformed"/>
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Parameters/CoolingTowers/CT_CellRatedKW" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="14.0,902.0,516.0,20.0" text="Tower min flow" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="530.0,903.0,416.0,35.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652" mouseOver="outline">
      <ActionBinding ord="station:|slot:/ChillerPlant/CdwLoop/TowerStaging/CT_CdwMinFlow/set" widgetEvent="actionPerformed"/>
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/CdwLoop/TowerStaging/CT_CdwMinFlow" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="14.0,940.0,516.0,20.0" text="Tower approach (K)" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="530.0,941.0,416.0,35.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652" mouseOver="outline">
      <ActionBinding ord="station:|slot:/ChillerPlant/Parameters/CoolingTowers/CT_Approach/set" widgetEvent="actionPerformed"/>
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Parameters/CoolingTowers/CT_Approach" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="14.0,978.0,516.0,20.0" text="Bypass min-flow margin" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="530.0,979.0,416.0,35.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652" mouseOver="outline">
      <ActionBinding ord="station:|slot:/ChillerPlant/ChwLoop/Bypass/Byp_MinFlowMargin/set" widgetEvent="actionPerformed"/>
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/ChwLoop/Bypass/Byp_MinFlowMargin" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="14.0,1016.0,500.0,20.0" text="DP setpoint min / max (end of loop)" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="530.0,1017.0,200.0,35.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652" mouseOver="outline">
      <ActionBinding ord="station:|slot:/ChillerPlant/Parameters/ChwLoop_AI/DP_MinSetpoint/set" widgetEvent="actionPerformed"/>
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Parameters/ChwLoop_AI/DP_MinSetpoint" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <BoundLabel layout="740.0,1017.0,200.0,35.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652" mouseOver="outline">
      <ActionBinding ord="station:|slot:/ChillerPlant/Parameters/ChwLoop_AI/DP_MaxSetpoint/set" widgetEvent="actionPerformed"/>
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Parameters/ChwLoop_AI/DP_MaxSetpoint" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="960.0,420.0,950.0,650.0"/>

    <Label layout="960.0,420.0,950.0,20.0" text="  DESIGN NOTES" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

    <Label layout="976.0,450.0,920.0,26.0" text="Chilled water: 300 RT × 2.4 gpm/RT = 720 gpm per chiller (ΔT ≈ 5.6 K / 10 °F)." font="9.5pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="976.0,482.0,920.0,26.0" text="Variable primary flow: min evaporator flow 216 gpm (30 %) held by the min-flow bypass valve" font="9.5pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="976.0,514.0,920.0,26.0" text="   (setpoint = sum of running chillers' min flow × margin). Keeps the evaporator in turbulent flow;" font="9.5pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="976.0,546.0,920.0,26.0" text="   compressor surge at low lift / low load is handled by the magnetic-bearing chiller controller." font="9.5pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="976.0,578.0,920.0,26.0" text="CHP head 110 ft: evaporator 20 + plant piping / valves / strainer 18 + mains 30 + index AHU coil 15" font="9.5pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="976.0,610.0,920.0,26.0" text="   + control valve 18 = 101 ft, +10 % margin. End-of-loop DP setpoint range 0.6 – 1.5 bar." font="9.5pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="976.0,642.0,920.0,26.0" text="Condenser water: 300 RT × 3 gpm/RT = 900 gpm. Heat rejection ≈ 1.2 × 300 RT → range 5.3 K." font="9.5pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="976.0,674.0,920.0,26.0" text="CDP head 80 ft: condenser 25 + crossflow tower static lift 14 (gravity hot-water basin," font="9.5pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="976.0,706.0,920.0,26.0" text="   no nozzle pressure) + piping / fittings 25 + strainer 5 = 69 ft, +10 % → 76, rounded up to 80 ft." font="9.5pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="976.0,738.0,920.0,26.0" text="Tower: crossflow 900 gpm, 27 °C design WB, approach 3.0 K → CWS 30.0 °C (CDS SP clamp 24 – 32 °C)." font="9.5pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="976.0,770.0,920.0,26.0" text="Drives: ABB ACH580 (HVAC) sized on motor kW and current (normal duty): 22 kW pumps → 045A-4," font="9.5pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="976.0,802.0,920.0,26.0" text="   5.5 kW tower fans → 012A-4. Pump drives min 30 % (CHP) / 40 % (CDP), fans min 20 %." font="9.5pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="976.0,834.0,920.0,26.0" text="VPF staging: 2nd chiller starts when the running chiller's FCV throttles &lt; 90 % (flow &gt; 720 gpm) for 5 min;" font="9.5pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="976.0,866.0,920.0,26.0" text="   held while plant flow &gt; 80 % of one chiller max. Flow follows pump speed on the pump curve." font="9.5pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="976.0,898.0,920.0,26.0" text="Values are a reference design for the simulation; confirm with the selected equipment data." font="9.5pt sans-serif" foreground="#dde3ea" halign="left"/>

  </CanvasPane>

</ScrollPane>
</content>
</px>
