    <Label layout="1418.0,136.0,214.0,50.0" text="Integral VFD compressor" font="9.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="1640.0,136.0,256.0,50.0" text="BACnet (chiller controller)" font="9.0pt sans-serif" foreground="#e8edf2" halign="left"/>

