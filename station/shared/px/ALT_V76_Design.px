    <Label layout="804.0,136.0,274.0,15.3" text="Evap 720 gpm max / 216 gpm min (30 %) · Cond 900" font="9.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="804.0,151.3,274.0,15.3" text="gpm" font="9.0pt sans-serif" foreground="#e8edf2" halign="left"/>

