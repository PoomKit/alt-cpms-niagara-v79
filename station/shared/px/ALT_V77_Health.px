      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="1274.0,824.0,326.0,20.0" text="CHWST active setpoint" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="1600.0,825.0,306.0,27.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/ModeControl/CHW_LeavingTemperatureSetpoint_ACTIVE" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="1276.0,870.0,620.0,18.0" text="Peak kW over 15 min sets the monthly demand charge. While active, CHWST rises" font="8.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="1276.0,888.0,620.0,18.0" text="0.1 K/min up to the max raise; it returns when kW is below target or off-peak." font="8.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="1276.0,906.0,620.0,18.0" text="Public holidays: add special events to Sch_TouPeak (Smart/Demand)." font="8.0pt sans-serif" foreground="#e8edf2" halign="left"/>

  </CanvasPane>

</ScrollPane>
</content>
