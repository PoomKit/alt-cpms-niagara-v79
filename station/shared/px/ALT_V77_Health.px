      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="1274.0,734.0,326.0,20.0" text="CHWST raise (K)" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="1600.0,735.0,306.0,27.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Smart/Demand/DL_ChwstOffset" popupEnabled="true" statusEffect="none">
