    <Label layout="14.0,818.0,296.0,20.0" text="CT-01 degraded" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="310.0,819.0,306.0,23.0" font="bold 10.0pt sans-serif" foreground="white" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Smart/FDD/CT01/FDD_CT01_ApproachAlarm" popupEnabled="true" statusEffect="none">
