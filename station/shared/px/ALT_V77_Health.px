    <BoundLabel layout="1600.0,795.0,306.0,27.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652" mouseOver="outline">
      <ActionBinding ord="station:|slot:/ChillerPlant/Smart/Demand/DL_ChwstCeiling/set" widgetEvent="actionPerformed"/>
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Smart/Demand/DL_ChwstCeiling" popupEnabled="true" statusEffect="none">
