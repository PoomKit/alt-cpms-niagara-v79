    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="1270.0,560.0,640.0,510.0"/>

    <Label layout="1270.0,560.0,640.0,20.0" text="  TOU PEAK DEMAND LIMIT  (Mon–Fri 09:00–22:00)" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

    <Label layout="1274.0,584.0,326.0,20.0" text="TOU period now" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="1600.0,585.0,306.0,27.0" font="bold 10.0pt sans-serif" foreground="white" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Smart/Demand/DL_PeakNow" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#f39c12"/>
          <Brush name="falseValue" value="#5d6d7e"/>
        </IBooleanToSimple>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="1274.0,614.0,326.0,20.0" text="Demand limit" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="1600.0,615.0,306.0,27.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652" mouseOver="outline">
      <ActionBinding ord="station:|slot:/ChillerPlant/Smart/Demand/DL_Enable/set" widgetEvent="actionPerformed"/>
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Smart/Demand/DL_Enable" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="1274.0,644.0,326.0,20.0" text="Target plant kW" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="1600.0,645.0,306.0,27.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652" mouseOver="outline">
      <ActionBinding ord="station:|slot:/ChillerPlant/Smart/Demand/DL_TargetKW/set" widgetEvent="actionPerformed"/>
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Smart/Demand/DL_TargetKW" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="1274.0,674.0,326.0,20.0" text="Plant kW now" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="1600.0,675.0,306.0,27.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
