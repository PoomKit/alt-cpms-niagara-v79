    <Label layout="1711.1,44.0,65.3,26.0" text="OAU-01" font="bold 8.5pt sans-serif" foreground="#cfd8dc" background="#233a33" halign="center">
      <ValueBinding ord="station:|slot:/" hyperlink="file:^px/ALT_V7_OAU01.px" popupEnabled="false"/>
    </Label>

    <Label layout="1779.4,44.0,65.3,26.0" text="FCU" font="bold 8.5pt sans-serif" foreground="#cfd8dc" background="#233a33" halign="center">
      <ValueBinding ord="station:|slot:/" hyperlink="file:^px/ALT_V7_FCU.px" popupEnabled="false"/>
    </Label>

    <Label layout="1847.7,44.0,65.3,26.0" text="Ventilation" font="bold 8.5pt sans-serif" foreground="#cfd8dc" background="#233a33" halign="center">
      <ValueBinding ord="station:|slot:/" hyperlink="file:^px/ALT_V7_Ventilation.px" popupEnabled="false"/>
    </Label>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="10.0,80.0,945.0,990.0"/>

    <Label layout="10.0,80.0,945.0,20.0" text="  CHILLER 01  ⊞" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="left">
      <PopupBinding ord="file:^px/ALT_V71_FP_CH01.px" title="CHILLER 01"/>
    </Label>

    <Picture layout="30.0,110.0,220.0,100.0" image="module://kitPxGraphics/Chillers/Generic/Chiller_Generic_Off.png">
      <ValueBinding ord="station:|slot:/ChillerPlant/Chiller01/Proof/CH01RunProofSelected">
        <IBooleanToSimple name="image">
          <Image name="trueValue" value="module://kitPxGraphics/Chillers/Generic/Chiller_Generic_On.gif"/>
          <Image name="falseValue" value="module://kitPxGraphics/Chillers/Generic/Chiller_Generic_Off.png"/>
        </IBooleanToSimple>
      </ValueBinding>
    </Picture>

    <BoundLabel layout="20.0,230.0,118.0,18.0" font="bold 9.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Chiller01/Points/CH01_ChwSupplyTemp" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="CHW LWT %out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <BoundLabel layout="20.0,252.0,118.0,18.0" font="bold 9.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Chiller01/Points/CH01_ChwReturnTemp" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="CHW EWT %out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <BoundLabel layout="142.0,230.0,118.0,18.0" font="bold 9.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Chiller01/Points/CH01_CdwLeavingTemp" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="CDW LWT %out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <BoundLabel layout="142.0,252.0,118.0,18.0" font="bold 9.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Chiller01/Points/CH01_CdwEnteringTemp" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="CDW EWT %out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="280.0,110.0,300.0,20.0" text="CH01 kW/RT (chiller only)" font="bold 9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="280.0,130.0,300.0,36.0" font="bold 16.0pt sans-serif" foreground="white" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Chiller01/Monitor/CH01_kW_per_RT" popupEnabled="true" statusEffect="none">
        <INumericToSimple name="background" map="gx:Brush 0.0:0.01=#2c3440;0.01:0.75=#1e8449;0.75:0.9=#7dcea0;0.9:1.0=#f4d03f;1.0:99.0=#e74c3c;default=#2c3440;"/>
        <ObjectToString name="text" format="%out.value% kW/RT"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Rect fill="#1e8449" stroke="#1e8449" pen="1.0" geom="280.0,170.0,73.0,12.0"/>

    <Label layout="280.0,184.0,73.0,14.0" text="&lt;0.75" font="7.0pt sans-serif" foreground="#1e8449" halign="center"/>

    <Rect fill="#7dcea0" stroke="#7dcea0" pen="1.0" geom="355.0,170.0,73.0,12.0"/>

    <Label layout="355.0,184.0,73.0,14.0" text="0.75-0.90" font="7.0pt sans-serif" foreground="#7dcea0" halign="center"/>

    <Rect fill="#f4d03f" stroke="#f4d03f" pen="1.0" geom="430.0,170.0,73.0,12.0"/>

    <Label layout="430.0,184.0,73.0,14.0" text="0.90-1.00" font="7.0pt sans-serif" foreground="#f4d03f" halign="center"/>

    <Rect fill="#e74c3c" stroke="#e74c3c" pen="1.0" geom="505.0,170.0,73.0,12.0"/>

    <Label layout="505.0,184.0,73.0,14.0" text="&gt;1.00" font="7.0pt sans-serif" foreground="#e74c3c" halign="center"/>

