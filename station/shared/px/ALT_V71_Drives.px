    <Label layout="1500.0,84.0,86.0,26.0" text="Detail" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="center"/>

    <Label layout="20.0,114.0,146.0,26.0" text="  CHP01" font="bold 10.0pt sans-serif" foreground="white" background="#1b2631" halign="left">
      <PopupBinding ord="file:^px/ALT_V71_FP_CHP01.px" title="CHP01"/>
    </Label>

    <BoundLabel layout="170.0,116.0,86.0,22.0" font="bold 10.0pt sans-serif" foreground="white" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/CHP01/Points/CHP01RunProof" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
        <IBooleanToSimple name="background">
