    <Label layout="20.0,624.0,1700.0,20.0" text="  HOW MIN / MAX IS APPLIED" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

    <Label layout="30.0,650.0,1680.0,20.0" text="speed = MIN( MAX(control output, MIN speed), MAX(MAX speed, MIN speed) ) — after the PID / reset / fail-safe selection, before the start gate." font="10.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="30.0,678.0,1680.0,20.0" text="Cooling towers: every fan cell (CT-01/01, CT-01/02, CT-02/01, CT-02/02) has its own VSD, MIN / MAX and faults; a failed cell drops out and the other" font="10.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="30.0,706.0,1680.0,20.0" text="cell of the tower keeps running. Cell speed = common CDS PID output (direct acting) after the SOO initial-speed hold." font="10.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="30.0,734.0,1680.0,20.0" text="CPEF01 ignores MAX during fire alarm (100 %). Values are writable (&lt;unit&gt;_MinSpeed / _MaxSpeed): click a green value to set." font="10.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="30.0,762.0,1680.0,20.0" text="Standard drive graphic is original; replace shared/px/img/vsd_drive.png with the project drive photo if required." font="10.0pt sans-serif" foreground="#e8edf2" halign="left"/>

