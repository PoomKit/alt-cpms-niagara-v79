          <Image name="trueValue" value="module://kitPxGraphics/Misc/Misc_roofexh/misc_roofexh_On.gif"/>
          <Image name="falseValue" value="module://kitPxGraphics/Misc/Misc_roofexh/misc_roofexh_Off.png"/>
