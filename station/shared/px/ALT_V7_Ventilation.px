      <BoundLabelBinding ord="station:|slot:/AirSide/SEF01/Monitor/SEF01_FireFailAlarm" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#e74c3c"/>
          <Brush name="falseValue" value="#1f6f43"/>
        </IBooleanToSimple>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="1594.0,791.0,136.0,20.0" text="Test run" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="1730.0,792.0,146.0,18.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652" mouseOver="outline">
      <ActionBinding ord="station:|slot:/AirSide/SEF01/Points/SEF01_TestRun/set" widgetEvent="actionPerformed"/>
      <BoundLabelBinding ord="station:|slot:/AirSide/SEF01/Points/SEF01_TestRun" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="20.0,1050.0,1200.0,20.0" text="Fire alarm: normal HVAC fans stop; LSF01 / SEF01 / CPEF01 start (CPEF01 100 %). Fan fail / in hand / overload / runtime-exceeded alarms per SOO FAN-1/3." font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

  </CanvasPane>

</ScrollPane>
</content>
</px>
