<?xml version="1.0" encoding="UTF-8"?>
<!-- Niagara Presentation XML -->
<px version="1.0" media="uxBuilder:UxMedia">
<import>
  <module name="baja"/>
  <module name="bajaui"/>
  <module name="converters"/>
  <module name="gx"/>
  <module name="kitPx"/>
</import>
<content>
<ScrollPane>

  <CanvasPane name="content" viewSize="1920.0,1080.0" scale="fitRatio" minScaleFactor="0.5" maxScaleFactor="1.0">

    <Rect fill="#12161b" stroke="#12161b" pen="1.0" geom="0.0,0.0,1920.0,1080.0"/>

    <Label layout="0.0,0.0,1920.0,40.0" text="  ALT Reference V7.9 — Building · floors / zones (temp · RH · CO2)" font="bold 18.0pt sans-serif" foreground="white" background="#0b0e11" halign="left"/>

    <Label layout="1450.0,8.0,460.0,24.0" text="SAME DATA AS 3D DIGITAL TWIN · REFERENCE SIMULATION" font="bold 10.0pt sans-serif" foreground="#263238" background="#ffca28" halign="center"/>

    <Label layout="8.0,44.0,150.0,26.0" text="Plant schematic" font="bold 9.0pt sans-serif" foreground="#cfd8dc" background="#2c3440" halign="center">
      <PopupBinding ord="file:^px/ALT_V79_Plant_Details.px" title="Plant schematic"/>
    </Label>

    <Label layout="162.0,44.0,150.0,26.0" text="Plant cards" font="bold 9.0pt sans-serif" foreground="#cfd8dc" background="#2c3440" halign="center">
      <PopupBinding ord="file:^px/ALT_V79_PlantCards.px" title="Plant cards"/>
    </Label>

    <Label layout="316.0,44.0,150.0,26.0" text="Building / Zones" font="bold 9.0pt sans-serif" foreground="white" background="#1e88e5" halign="center"/>

    <Label layout="470.0,44.0,150.0,26.0" text="3D Live" font="bold 9.0pt sans-serif" foreground="#cfd8dc" background="#2c3440" halign="center">
      <HyperlinkBinding ord="file:^web/ALT_V79_Building3D.html"/>
    </Label>

    <Label layout="624.0,44.0,150.0,26.0" text="Field IO" font="bold 9.0pt sans-serif" foreground="#cfd8dc" background="#2c3440" halign="center">
      <PopupBinding ord="file:^px/ALT_V77_FieldIO.px" title="Field IO"/>
    </Label>

    <Label layout="778.0,44.0,150.0,26.0" text="Alarms" font="bold 9.0pt sans-serif" foreground="#cfd8dc" background="#2c3440" halign="center">
      <PopupBinding ord="file:^px/ALT_CP_AlarmsHistory.px" title="Alarms"/>
    </Label>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="8.0,80.0,1904.0,112.0"/>

    <Label layout="8.0,80.0,1904.0,20.0" text="  FLOOR 8" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

    <Label layout="16.0,104.0,115.0,20.0" text="AHU run" font="9.0pt sans-serif" foreground="#9aa5b1" halign="left"/>

    <BoundLabel layout="131.0,105.0,107.0,18.0" font="bold 10.0pt sans-serif" foreground="white" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/AirSide/Floors/F08/AHU_F08_Status" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#2ecc71"/>
          <Brush name="falseValue" value="#5d6d7e"/>
        </IBooleanToSimple>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="16.0,125.0,115.0,20.0" text="CHW valve %" font="9.0pt sans-serif" foreground="#9aa5b1" halign="left"/>

