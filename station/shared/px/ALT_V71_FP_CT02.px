    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="10.0,206.0,600.0,138.0"/>

    <Label layout="10.0,206.0,600.0,20.0" text="  FAN CELLS (click for the cell VSD)" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

    <Label layout="180.0,230.0,210.0,20.0" text="CT-02/01  ⊞" font="bold 9.0pt sans-serif" foreground="white" background="#5b3a1a" halign="center">
