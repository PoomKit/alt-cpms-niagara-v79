    <BoundLabel layout="395.0,252.0,210.0,20.0" font="bold 9.0pt sans-serif" foreground="white" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/CT02/Cell02/Points/CT02_02RunProof" popupEnabled="true" statusEffect="none">
