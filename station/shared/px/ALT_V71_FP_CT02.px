    <Label layout="14.0,784.0,356.0,20.0" text="" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="370.0,785.0,236.0,19.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/CT02/Points/CT02_OutletMVFb" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Button layout="10.0,820.0,140.0,26.0" text="RESET CT02" font="bold 10.0pt sans-serif" foreground="white" background="#c62828">
      <ActionBinding ord="station:|slot:/ChillerPlant/CT02/Logic/CT02ResetFire/fire" widgetEvent="actionPerformed"/>
    </Button>

  </CanvasPane>

</ScrollPane>
</content>
