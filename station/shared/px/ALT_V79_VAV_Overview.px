<?xml version="1.0" encoding="UTF-8"?>
<!-- Niagara Presentation XML -->
<px version="1.0" media="uxBuilder:UxMedia">
<import>
  <module name="baja"/>
  <module name="bajaui"/>
  <module name="converters"/>
  <module name="gx"/>
  <module name="kitPx"/>
</import>
<content>
<ScrollPane>

  <CanvasPane name="content" viewSize="1920.0,1080.0" scale="fitRatio" minScaleFactor="0.5" maxScaleFactor="1.0">

    <Rect fill="#12161b" stroke="#12161b" pen="1.0" geom="0.0,0.0,1920.0,1080.0"/>

    <Label layout="0.0,0.0,1920.0,40.0" text="  ALT Reference V7.9 r4 — Office floors · VAV AHUs and energy" font="bold 18.0pt sans-serif" foreground="white" background="#0b0e11" halign="left"/>

    <Label layout="1300.0,8.0,610.0,24.0" text="LIVE STATION POINTS · R9 OFFICE DESIGN · REFERENCE SIMULATION" font="bold 10.0pt sans-serif" foreground="#263238" background="#ffca28" halign="center"/>

    <Label layout="8.0,44.0,132.0,26.0" text="VAV overview" font="bold 9.0pt sans-serif" foreground="white" background="#1e88e5" halign="center"/>

    <Label layout="144.0,44.0,132.0,26.0" text="F02 VAV" font="bold 9.0pt sans-serif" foreground="#cfd8dc" background="#2c3440" halign="center">
      <PopupBinding ord="file:^px/ALT_V79_F02_VAV.px" title="F02 VAV"/>
    </Label>

    <Label layout="280.0,44.0,132.0,26.0" text="F03 VAV" font="bold 9.0pt sans-serif" foreground="#cfd8dc" background="#2c3440" halign="center">
      <PopupBinding ord="file:^px/ALT_V79_F03_VAV.px" title="F03 VAV"/>
    </Label>

    <Label layout="416.0,44.0,132.0,26.0" text="F04 VAV" font="bold 9.0pt sans-serif" foreground="#cfd8dc" background="#2c3440" halign="center">
      <PopupBinding ord="file:^px/ALT_V79_F04_VAV.px" title="F04 VAV"/>
    </Label>

    <Label layout="552.0,44.0,132.0,26.0" text="F05 VAV" font="bold 9.0pt sans-serif" foreground="#cfd8dc" background="#2c3440" halign="center">
