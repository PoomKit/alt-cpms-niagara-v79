    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="20.0,90.0,930.0,460.0"/>

    <Label layout="20.0,90.0,930.0,20.0" text="  FCU01" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

    <Picture layout="40.0,130.0,578.0,99.0" image="module://kitPxGraphics/Misc/Misc_FCU/misc_fcu.png"/>

    <Picture layout="420.0,130.0,134.0,99.0" image="module://kitPxGraphics/Misc/Misc_FCU/Fan/misc_fcu_fan_off.png">
      <ValueBinding ord="station:|slot:/AirSide/FCU01/Points/FCU01_Status">
        <IBooleanToSimple name="image">
          <Image name="trueValue" value="module://kitPxGraphics/Misc/Misc_FCU/Fan/misc_fcu_fan_on.gif"/>
          <Image name="falseValue" value="module://kitPxGraphics/Misc/Misc_FCU/Fan/misc_fcu_fan_off.png"/>
        </IBooleanToSimple>
      </ValueBinding>
    </Picture>

    <Picture layout="160.0,130.0,99.0,99.0" image="module://kitPxGraphics/Misc/Misc_FCU/Cooling_Coil/misc_fcu_CoolingCoil_off.png">
      <ValueBinding ord="station:|slot:/AirSide/FCU01/Points/FCU01_ValveCmd">
        <IBooleanToSimple name="image">
          <Image name="trueValue" value="module://kitPxGraphics/Misc/Misc_FCU/Cooling_Coil/misc_fcu_CoolingCoil_on.png"/>
          <Image name="falseValue" value="module://kitPxGraphics/Misc/Misc_FCU/Cooling_Coil/misc_fcu_CoolingCoil_off.png"/>
        </IBooleanToSimple>
      </ValueBinding>
    </Picture>

    <Picture layout="680.0,130.0,69.0,90.0" image="module://kitPxGraphics/Sensors/Sensors_Tstat/tstat04.png"/>

    <BoundLabel layout="760.0,150.0,90.0,28.0" font="bold 14.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/AirSide/FCU01/Points/FCU01_RoomTemp" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="760.0,182.0,90.0,20.0" text="setpoint" font="8.0pt sans-serif" foreground="#c9d3dd" halign="center"/>

    <BoundLabel layout="760.0,200.0,90.0,22.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652" mouseOver="outline">
      <ActionBinding ord="station:|slot:/AirSide/FCU01/Points/FCU01_RoomTemp_SP/set" widgetEvent="actionPerformed"/>
      <BoundLabelBinding ord="station:|slot:/AirSide/FCU01/Points/FCU01_RoomTemp_SP" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="34.0,250.0,146.0,20.0" text="Command" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="180.0,251.0,146.0,18.0" font="bold 10.0pt sans-serif" foreground="white" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/AirSide/FCU01/Points/FCU01_StartCmd" popupEnabled="true" statusEffect="none">
