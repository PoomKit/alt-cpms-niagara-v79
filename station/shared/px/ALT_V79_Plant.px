        <Label layout="40.0,28.0,1160.0,32.0" text="ALT  /  CHILLER PLANT" font="bold 22.0pt sans-serif" foreground="#283640" halign="left" />
        <Label layout="40.0,65.0,1120.0,24.0" text="Water systems  ·  Headered pump pools  ·  6 equipment slots" font="11.0pt sans-serif" foreground="#63717b" halign="left" />
