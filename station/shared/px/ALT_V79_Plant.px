    <Label layout="588.0,78.0,112.0,16.0" text="CHWR" font="9.0pt sans-serif" foreground="#c9d3dd" halign="center"/>

    <BoundLabel layout="594.0,96.0,100.0,24.0" font="bold 12.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
