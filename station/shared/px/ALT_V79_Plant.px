    <Button layout="1406.0,78.0,150.0,22.0" text="RESET ALL" font="bold 10.0pt sans-serif" foreground="white" background="#c62828">
      <ActionBinding ord="station:|slot:/ChillerPlant/Alarms/Plant/PlantAlarmResetFire/fire" widgetEvent="actionPerformed"/>
    </Button>

    <Button foreground="white" layout="1406.0,102.0,72.0,22.0" text="PLANT ON" font="bold 11.0pt sans-serif">
      <ActionBinding ord="station:|slot:/ChillerPlant/PlantControl/Points/PlantEnable/set" widgetEvent="actionPerformed">
        <Boolean name="actionArg" value="true"/>
      </ActionBinding>
      <ValueBinding ord="station:|slot:/ChillerPlant/PlantControl/Points/PlantEnable" popupEnabled="false">
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#1e8449"/>
          <Brush name="falseValue" value="#2c3440"/>
        </IBooleanToSimple>
      </ValueBinding>
    </Button>

    <Button foreground="white" layout="1484.0,102.0,72.0,22.0" text="OFF" font="bold 11.0pt sans-serif">
      <ActionBinding ord="station:|slot:/ChillerPlant/PlantControl/Points/PlantEnable/set" widgetEvent="actionPerformed">
        <Boolean name="actionArg" value="false"/>
      </ActionBinding>
      <ValueBinding ord="station:|slot:/ChillerPlant/PlantControl/Points/PlantEnable" popupEnabled="false">
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#2c3440"/>
          <Brush name="falseValue" value="#7b241c"/>
        </IBooleanToSimple>
      </ValueBinding>
    </Button>

    <Button foreground="white" layout="1564.0,78.0,90.0,22.0" text="QUALIFY" font="bold 11.0pt sans-serif">
      <ActionBinding ord="station:|slot:/ChillerPlant/PlantControl/Points/BootQualified/set" widgetEvent="actionPerformed">
        <Boolean name="actionArg" value="true"/>
      </ActionBinding>
      <ValueBinding ord="station:|slot:/ChillerPlant/PlantControl/Points/BootQualified" popupEnabled="false">
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#1e8449"/>
          <Brush name="falseValue" value="#2c3440"/>
        </IBooleanToSimple>
      </ValueBinding>
    </Button>

    <Button foreground="white" layout="1564.0,102.0,90.0,22.0" text="AI / LOCAL" font="bold 11.0pt sans-serif">
      <ActionBinding ord="station:|slot:/ChillerPlant/ModeControl/ModeCmd_UI/set" widgetEvent="actionPerformed">
        <Boolean name="actionArg" value="true"/>
      </ActionBinding>
      <ValueBinding ord="station:|slot:/ChillerPlant/ModeControl/ModeCmd_UI" popupEnabled="false">
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#1e8449"/>
          <Brush name="falseValue" value="#2c3440"/>
        </IBooleanToSimple>
      </ValueBinding>
    </Button>

