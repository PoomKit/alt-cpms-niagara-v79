    <BoundLabel layout="1296.0,619.0,136.0,25.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Simulation/Hydraulic/Sim_CoilFlowRatio" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="980.0,646.0,316.0,20.0" text="AI heartbeat emulation" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="1296.0,647.0,136.0,25.0" font="bold 10.0pt sans-serif" foreground="#7dcea0" background="#0b0e11" halign="center" border="1.0 solid #3b4652" mouseOver="outline">
      <ActionBinding ord="station:|slot:/ChillerPlant/Simulation/Ramps/Sim_AiHeartbeatEnable/set" widgetEvent="actionPerformed"/>
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Simulation/Ramps/Sim_AiHeartbeatEnable" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="1452.0,592.0,430.0,20.0" text="DP = pump curve vs system curve (speed², pumps, demand)." font="8.5pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <Label layout="1452.0,614.0,430.0,20.0" text="Coil flow = demand × √(DP / 1.0 bar): high DP over-flows the coils" font="8.5pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <Label layout="1452.0,636.0,430.0,20.0" text="→ low ΔT. Set the factor to 0.6 to see the guard work." font="8.5pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="976.0,698.0,920.0,362.0"/>

    <Label layout="976.0,698.0,920.0,20.0" text="  HOW IT WORKS" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

    <Label layout="990.0,724.0,900.0,22.0" text="Layer 1 (unchanged): CHW pumps hold the DP at the END of the loop → every AHU gets its water. The DP setpoint" font="9.0pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="990.0,754.0,900.0,22.0" text="   comes from Trim &amp; Respond on the AHU valve requests (or the AI in AI mode)." font="9.0pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="990.0,784.0,900.0,22.0" text="Layer 2 (new): plant ΔT below the limit = low ΔT syndrome (over-flow, valves hunting, dirty coils, 3-way valves)." font="9.0pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="990.0,814.0,900.0,22.0" text="   → the guard takes up to 30 % off the DP setpoint, slowly (PI, then rate-limited) → less flow, higher ΔT," font="9.0pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="990.0,844.0,900.0,22.0" text="   less pump kW, and the chiller is not forced to stage up on flow instead of load." font="9.0pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="990.0,874.0,900.0,22.0" text="Priority to the end of the loop: when any AHU asks for more water (CHW request) the whole cut is removed" font="9.0pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="990.0,904.0,900.0,22.0" text="   at once and the guard is HELD for 15 min. The guard never goes below the plant DP minimum." font="9.0pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="990.0,934.0,900.0,22.0" text="If ΔT stays low with the cut at its limit for 30 min → alarm: look for the cause on the water side" font="9.0pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="990.0,964.0,900.0,22.0" text="   (coil valves wide open, 3-way / bypass valves, fouled coils, AHU setpoints too low)." font="9.0pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="990.0,994.0,900.0,22.0" text="Layer 0 (V7.3): a 2nd chiller is not started on low ΔT alone (staging uses load; Low ΔT alarm after 15 min)." font="9.0pt sans-serif" foreground="#dde3ea" halign="left"/>

    <Label layout="990.0,1024.0,900.0,22.0" text="Needs valid CHWS / CHWR / flow sensors. DP sensor judged only while a CHW pump is proven (no false alarm)." font="9.0pt sans-serif" foreground="#dde3ea" halign="left"/>

  </CanvasPane>

</ScrollPane>
</content>
</px>
