    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="10.0,370.0,1180.0,120.0"/>

    <Label layout="10.0,370.0,1180.0,20.0" text="  SCHEDULE USE" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

    <Label layout="14.0,394.0,296.0,20.0" text="Plant schedule mode" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="310.0,395.0,286.0,25.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652" mouseOver="outline">
      <ActionBinding ord="station:|slot:/ChillerPlant/PlantControl/Points/PlantScheduleMode/set" widgetEvent="actionPerformed"/>
