    <Label layout="24.0,540.0,1160.0,20.0" text="EDIT opens the BooleanSchedule in its default Workbench / web view (Scheduler): drag weekly blocks per day, add special events" font="10.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="24.0,566.0,1160.0,20.0" text="(date, date range, week-and-day, custom) and link holiday calendars. Output now / next change / next value are live." font="10.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="24.0,592.0,1160.0,20.0" text="Schedules live in /AirSide/Schedules and /ChillerPlant/PlantControl; every unit links its schedule output into &lt;unit&gt;/Logic." font="10.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="24.0,618.0,1160.0,20.0" text="Plant: schedule mode = Scheduled -&gt; plant enable follows PlantSchedule AND operator enable; demand mode -&gt; plant follows air-side calls." font="10.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="24.0,644.0,1160.0,20.0" text='Set selection = lead chiller; with "Pumps / towers follow set" each pool leads with the same unit number; a failed unit is still' font="10.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <Label layout="24.0,670.0,1160.0,20.0" text="replaced by the standby of its pool (cross-set operation CHP01 + CDP02 remains possible)." font="10.0pt sans-serif" foreground="#e8edf2" halign="left"/>

