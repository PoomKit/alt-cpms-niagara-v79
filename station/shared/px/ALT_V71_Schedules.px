    <Label layout="1214.0,584.0,690.0,20.0" text="Daily: lead set swaps every day at the trigger time. Weekly: every 7 days. Runtime mode has priority." font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <Label layout="1214.0,604.0,690.0,20.0" text="Change-over is make-before-break (standby started and proven before the old lead stops)." font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

