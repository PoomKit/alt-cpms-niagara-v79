    <Label layout="124.0,290.0,256.0,20.0" text="Frequency" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="380.0,291.0,241.0,23.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
