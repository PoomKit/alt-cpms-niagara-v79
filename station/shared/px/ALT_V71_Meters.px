      </BoundLabelBinding>
    </BoundLabel>

    <Rect fill="#1f252c" stroke="#3b4652" pen="1.0" geom="640.0,80.0,620.0,420.0"/>

    <Label layout="640.0,80.0,620.0,20.0" text="  BTU METER (CHW)  ⊞" font="bold 10.0pt sans-serif" foreground="white" background="#2c3e50" halign="left">
      <PopupBinding ord="file:^px/ALT_V71_FP_BTU.px" title="BTU METER (CHW)"/>
    </Label>

    <Picture layout="660.0,120.0,85.0,30.0" image="module://kitPxGraphics/Sensors/sensor_watermtr_horz_largepipe.png"/>

    <Label layout="644.0,160.0,296.0,20.0" text="Flow" font="9.0pt sans-serif" foreground="#c9d3dd" halign="left"/>

    <BoundLabel layout="940.0,161.0,316.0,23.0" font="bold 10.0pt sans-serif" foreground="#ffe066" background="#0b0e11" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Metering/BTU/BTU_Flow" popupEnabled="true" statusEffect="none">
