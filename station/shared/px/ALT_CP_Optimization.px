    <Label layout="810.0,492.0,170.0,22.0" text="Mismatch alarm" font="11.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <BoundLabel background="#0b0e11" layout="980.0,492.0,110.0,22.0" font="12.0pt sans-serif" foreground="#ffe066" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Alarms/Plant/CHW_BypassValvePositionMismatch" popupEnabled="true" statusEffect="none">
        <ObjectToString name="text" format="%out.value%"/>
        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#e53935"/>
          <Brush name="falseValue" value="#1f6f43"/>
        </IBooleanToSimple>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="1200.0,492.0,170.0,22.0" text="Flow low alarm" font="11.0pt sans-serif" foreground="#e8edf2" halign="left"/>

    <BoundLabel background="#0b0e11" layout="1370.0,492.0,110.0,22.0" font="12.0pt sans-serif" foreground="#ffe066" halign="center" border="1.0 solid #3b4652">
      <BoundLabelBinding ord="station:|slot:/ChillerPlant/Alarms/Plant/CHW_FlowLowAlarm" popupEnabled="true" statusEffect="none">
