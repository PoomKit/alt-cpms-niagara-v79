      <ActionBinding ord="station:|slot:/ChillerPlant/Chiller01/Fault/CH01ResetFire/fire" widgetEvent="actionPerformed"/>
    </Button>

    <Button layout="802.0,806.0,140.0,26.0" text="RESET CH02" font="bold 10.0pt sans-serif" foreground="white" background="#c62828">
      <ActionBinding ord="station:|slot:/ChillerPlant/Chiller02/Fault/CH02ResetFire/fire" widgetEvent="actionPerformed"/>
