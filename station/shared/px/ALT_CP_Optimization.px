        <IBooleanToSimple name="background">
          <Brush name="trueValue" value="#e53935"/>
          <Brush name="falseValue" value="#1f6f43"/>
        </IBooleanToSimple>
      </BoundLabelBinding>
    </BoundLabel>

    <Label layout="810.0,528.0,770.0,17.0" text="SP = Σ minimum flow of chillers whose isolation valve is open. Reverse-acting PID opens the bypass when flow &lt; SP (rate-" font="10.0pt sans-serif" foreground="#9aa5b1" halign="left"/>

    <Label layout="810.0,545.0,770.0,17.0" text="limited). Bypass closed whenever plant/pumps are off. Command ≠ feedback &gt; 10 % for 2 min → alarm." font="10.0pt sans-serif" foreground="#9aa5b1" halign="left"/>

    <Rect fill="#1f252c" stroke="#3b4652" pen="2.0" geom="10.0,650.0,1580.0,240.0"/>

    <Label layout="10.0,650.0,1580.0,24.0" text="  STAGING, FAILSAFE &amp; RUNTIME ROTATION" font="bold 12.0pt sans-serif" foreground="white" background="#2c3e50" halign="left"/>

