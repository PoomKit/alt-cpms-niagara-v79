      <ActionBinding ord="station:|slot:/ChillerPlant/Alarms/Plant/PlantAlarmResetFire/fire" widgetEvent="actionPerformed"/>
    </Button>

    <Label layout="20.0,840.0,1560.0,17.0" text="Stage 2 = plant load &gt; 90 % of one chiller for 10 min (off &lt; 60 % for 15 min) OR lead chiller &gt; 95 % for 10 min OR CHWS &gt; SP + margin 10 min. Program lockout (proof/aux timeout) auto-resets after 180 s, max N times, then RESET. Sensor/comms faults" font="10.0pt sans-serif" foreground="#9aa5b1" halign="left"/>

    <Label layout="20.0,857.0,1560.0,17.0" text="never stop the plant: the affected loop goes to its fail-safe output. Restart auto-qualifies after 120 s." font="10.0pt sans-serif" foreground="#9aa5b1" halign="left"/>

